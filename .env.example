# === Brulée — Gestió de Factures · variables d'entorn ===
# Copia aquest fitxer a `.env` i omple les claus. MAI committejar el `.env`.

# --- OpenAI (extracció GPT-4o Vision) ---
OPENAI_API_KEY=

# --- Gmail API (OAuth 2.0) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# --- Supabase (safata de revisió `gastos_pendents`) ---
# Project Settings → API. La service_role key salta el RLS: només al servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
PORT=3000
DB_PATH=./brulee.sqlite
